# Maintainer: Vaela contributors
pkgname=vaela-desktop
pkgver=1.3.8
pkgrel=1
pkgdesc='A Vivaldi-style Wayland desktop built on KWin'
arch=('x86_64')
url='https://github.com/PreCosmos/Vaela'
license=('GPL-2.0-or-later')
depends=('kwin' 'plasma-workspace' 'plasma-desktop' 'python' 'breeze'
         'breeze-icons' 'kscreenlocker' 'polkit-kde-agent' 'xdg-desktop-portal-kde'
         'systemsettings' 'kscreen' 'plasma-pa' 'print-manager' 'powerdevil'
         'kinfocenter' 'layer-shell-qt' 'spectacle' 'qt6-base>=6.12.0' 'qt6-declarative>=6.12.0'
         'qt6-multimedia' 'konsole' 'kglobalaccel' 'kservice' 'kio'
         'plasma-activities')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'vulkan-headers' 'libepoxy' 'libdrm')
optdepends=('dolphin: file manager' 'plasma-nm: network applet'
            'kde-gtk-config: GTK application appearance')
source=("vaela-desktop-$pkgver.tar.gz")
# Generated by scripts/build-arch.sh from the exact source archive.
sha256sums=('SOURCE_SHA256')

build() {
    cmake -S "$srcdir/vaela-desktop-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        "-DCMAKE_CXX_FLAGS=${CXXFLAGS} -march=x86-64 -mtune=generic" \
        -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_INSTALL_SYSCONFDIR=/etc \
        -DPLASMA_DBUS_HELPER=/usr/lib/plasma-dbus-run-session-if-needed
    cmake --build build --parallel "${VAELA_BUILD_JOBS:-2}"
}

check() {
    XDG_CACHE_HOME="$srcdir/test-cache" QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
        dbus-run-session -- ctest --test-dir build --output-on-failure --timeout 60
}

package() {
    # KWin's private plugin ABI requires a rebuild after an upstream version change.
    local kwin_version
    kwin_version=$(pacman -Q kwin | cut -d ' ' -f 2)
    kwin_version=${kwin_version%-*}
    depends[0]="kwin=$kwin_version"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/vaela-desktop-$pkgver/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
}
