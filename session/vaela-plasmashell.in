#!/usr/bin/python3
"""Keep Vaela's Plasma layout out of the regular Plasma configuration."""
import configparser
import os
from pathlib import Path
import shutil
import re
import subprocess
import sys


def session_environment():
    # Read the running compositor, not systemd's possibly stale imported variables.
    try:
        pid = int(subprocess.check_output(
            ["systemctl", "--user", "show", "plasma-kwin_wayland.service",
             "--property=MainPID", "--value"], timeout=5).strip())
        if pid > 0:
            return dict(item.split(b"=", 1) for item in
                        Path(f"/proc/{pid}/environ").read_bytes().split(b"\0") if b"=" in item)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return os.environb


def restore_plasma_wallpaper(text):
    blocks = re.split(r"(?=^\[)", text, flags=re.M)
    previous = {}
    for block in blocks:
        match = re.match(r"\[Containments\]\[(\d+)\]\[Wallpaper\]\[org.vaela.background\]\[General\]\n", block)
        if match:
            plugin = re.search(r"^Previous=(.*)$", block, re.M)
            previous[match[1]] = plugin.group(1) if plugin and plugin.group(1) else "org.kde.image"
    for index, block in enumerate(blocks):
        match = re.match(r"\[Containments\]\[(\d+)\]\n", block)
        if match:
            plugin = previous.get(match[1], "org.kde.image")
            if plugin == "org.vaela.background":
                plugin = "org.kde.image"
            blocks[index] = re.sub(r"^wallpaperplugin=org.vaela.background$",
                                   lambda _: "wallpaperplugin=" + plugin, block, flags=re.M)
    return "".join(blocks)


def merge_mimeapps(private, base):
    # Apps started from the shell inherit its config home and may save handlers there. KDE's
    # shared application database records every mimeapps.list it can see, so one that only the
    # shell sees makes it and the rest of the session rebuild the database for each other forever.
    for source in private.glob("*mimeapps.list"):
        target = base / source.name
        merged = configparser.RawConfigParser(strict=False, delimiters=("=",))
        merged.optionxform = str
        added = configparser.RawConfigParser(strict=False, delimiters=("=",))
        added.optionxform = str
        try:
            merged.read(target)
            added.read(source)
        except configparser.Error:
            source.replace(source.with_name(source.name + ".invalid"))
            continue
        changed = False
        for section in added.sections():
            if not merged.has_section(section):
                merged.add_section(section)
            for key, value in added.items(section):
                if not merged.has_option(section, key):
                    merged.set(section, key, value)
                    changed = True
        if changed:
            temporary = target.with_name(target.name + ".vaela-new")
            with temporary.open("w") as file:
                merged.write(file, space_around_delimiters=False)
            temporary.replace(target)
        source.unlink()


def configure(vaela):
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    private = base / "vaela-plasma"
    layout = base / "plasma-org.kde.plasma.desktop-appletsrc"
    original = layout.read_text() if layout.is_file() else ""
    restored = restore_plasma_wallpaper(original)
    if vaela or restored != original:
        private.mkdir(mode=0o700, parents=True, exist_ok=True)
        # Copy only the shell's state. Other user settings remain readable as defaults.
        for name in ("plasma-org.kde.plasma.desktop-appletsrc", "plasmashellrc"):
            source, target = base / name, private / name
            if source.is_file() and not target.exists():
                with source.open("rb") as src, target.open("xb") as dst:
                    os.chmod(target, 0o600)
                    shutil.copyfileobj(src, dst)
    # Upgrade older versions that selected Vaela's wallpaper in the shared layout.
    # Save the Vaela layout above before handing the regular desktop back to Plasma.
    if restored != original:
        backup = layout.with_name(layout.name + ".pre-vaela-isolation")
        if not backup.exists():
            shutil.copy2(layout, backup)
        layout.write_text(restored)
    if vaela:
        merge_mimeapps(private, base)
        os.environ["XDG_CONFIG_HOME"] = str(private)
        os.environ["XDG_CONFIG_DIRS"] = str(base) + ":" + os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg")


def main():
    configure(session_environment().get(b"VAELA_SESSION") == b"1")
    os.execv("@CMAKE_INSTALL_FULL_BINDIR@/plasmashell", ["plasmashell", *sys.argv[1:]])


if __name__ == "__main__":
    main()
